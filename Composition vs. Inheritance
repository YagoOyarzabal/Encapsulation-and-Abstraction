using System;

// ==========================================
// PARTE A — Por qué la herencia es un problema
// ==========================================
//
// Si creamos una jerarquía así:
//   Character -> Warrior -> FlyingWarrior
//   Character -> Mage -> FlyingMage
//   Character -> WarriorMage (que ataca y lanza hechizos)
//
// Terminamos con una "explosión" de clases combinadas.
// Cada nueva habilidad requiere crear una subclase nueva.
// Con el tiempo es imposible mantener.
//
// ==========================================
// PARTE B — Composición (solución flexible)
// ==========================================

// Interfaz para los comportamientos de ataque.
// Cualquier clase que implemente IAttackBehavior puede "atacar".
public interface IAttackBehavior
{
    void Attack();
}

// Interfaz para los comportamientos de movimiento.
public interface IMovementBehavior
{
    void Move();
}

// Implementaciones concretas de ataques:
public class SwordAttack : IAttackBehavior
{
    public void Attack()
    {
        Console.WriteLine("Ataca con una espada 🗡️");
    }
}

public class MagicAttack : IAttackBehavior
{
    public void Attack()
    {
        Console.WriteLine("Lanza un hechizo mágico ✨");
    }
}

// Implementaciones concretas de movimiento:
public class WalkingMovement : IMovementBehavior
{
    public void Move()
    {
        Console.WriteLine("Camina sobre el suelo 🚶‍♂️");
    }
}

public class FlyingMovement : IMovementBehavior
{
    public void Move()
    {
        Console.WriteLine("Vuela por los cielos 🕊️");
    }
}

// ==========================================
// CLASE PRINCIPAL: Character
// ==========================================
// No tiene subclases. En cambio, contiene (por composición)
// referencias a objetos de comportamiento.
//
public class Character
{
    private readonly IAttackBehavior _attackBehavior;
    private readonly IMovementBehavior _movementBehavior;
    private readonly string _name;

    // Constructor: se "inyectan" los comportamientos al crear el personaje.
    public Character(string name, IAttackBehavior attack, IMovementBehavior movement)
    {
        _name = name;
        _attackBehavior = attack;
        _movementBehavior = movement;
    }

    // Métodos que delegan la acción al comportamiento correspondiente.
    public void PerformAttack()
    {
        Console.Write($"{_name}: ");
        _attackBehavior.Attack();
    }

    public void PerformMove()
    {
        Console.Write($"{_name}: ");
        _movementBehavior.Move();
    }
}

// ==========================================
// PROGRAMA PRINCIPAL
// ==========================================
public class ProgramActivity3
{
    public static void Main(string[] args)
    {
        // Creamos personajes combinando comportamientos libremente:

        // Un guerrero que camina
        var warrior = new Character("Guerrero", new SwordAttack(), new WalkingMovement());

        // Un mago que vuela
        var mage = new Character("Mago", new MagicAttack(), new FlyingMovement());

        // Un guerrero volador (sin necesidad de crear una nueva subclase)
        var flyingWarrior = new Character("Guerrero Volador", new SwordAttack(), new FlyingMovement());

        // Probamos las acciones
        warrior.PerformMove();
        warrior.PerformAttack();

        mage.PerformMove();
        mage.PerformAttack();

        flyingWarrior.PerformMove();
        flyingWarrior.PerformAttack();
    }
}
